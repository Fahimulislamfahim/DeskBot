String encodeBase64(const uint8_t* buf, size_t bufLen) {
  static const char b64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  String out = "";
  out.reserve((bufLen * 4 / 3) + 4);
  for (size_t i = 0; i < bufLen; i += 3) {
    uint32_t b = (buf[i] << 16) | ((i + 1 < bufLen ? buf[i + 1] : 0) << 8) | (i + 2 < bufLen ? buf[i + 2] : 0);
    out += b64[(b >> 18) & 0x3F];
    out += b64[(b >> 12) & 0x3F];
    out += (i + 1 < bufLen) ? b64[(b >> 6) & 0x3F] : '=';
    out += (i + 2 < bufLen) ? b64[b & 0x3F] : '=';
  }
  return out;
}

