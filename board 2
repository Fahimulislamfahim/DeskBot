      display.fillCircle(24, 54, 2, SSD1306_WHITE);
      display.fillCircle(110, 52, 2, SSD1306_WHITE);
      display.fillCircle(104, 54, 2, SSD1306_WHITE);
    } else if (currentMood == "sleep_zzz") {
      zzzY = (zzzY + 1) % 28;
      display.setTextSize(1);
      display.setTextColor(SSD1306_WHITE);
      display.setCursor(102, 30 - zzzY); display.print("Z");
      if (zzzY > 8) { display.setCursor(108, 40 - zzzY); display.print("z"); }
      if (zzzY > 16) { display.setCursor(114, 50 - zzzY); display.print("z"); }
    }
  }

  display.display();
}

void performSmoothBlink() {
  String prev = currentMood;
  currentMood = "blink";
  for(int i = 0; i < 5; i++) { renderEyes(); delay(20); }
  currentMood = prev;
  for(int i = 0; i < 5; i++) { renderEyes(); delay(20); }
}

void handleRoot() { server.send(200, "text/html; charset=utf-8", HTML_PAGE); }

void handleSetMood() {
  if (server.hasArg("type")) {
    currentMood = server.arg("type");
    autoMode = false;
  }
  if (server.hasArg("sound")) {
    int snd = server.arg("sound").toInt();
    if (snd > 0) playSoundTrack(snd);
  }
  server.send(200, "text/plain", "OK");
}

void handleJoyMove() {
  if (server.hasArg("x") && server.hasArg("y")) {
    joyOffsetX = server.arg("x").toFloat();
    joyOffsetY = server.arg("y").toFloat();
    currentMood = "joystick";
    autoMode = false;
  }
  server.send(200, "text/plain", "OK");
}

void handleToggleAuto() {
  if (server.hasArg("state")) {
    autoMode = (server.arg("state").toInt() == 1);
  }
  server.send(200, "text/plain", "OK");
}

void handleGetFrame() {
  uint8_t* buffer = display.getBuffer();
  String base64Data = encodeBase64(buffer, 1024);
  server.send(200, "text/plain", base64Data);
}

void setup() {
  Serial.begin(115200);

  // Initialize Display
  Wire.begin(4, 5); // SDA = D2, SCL = D1
  Wire.setClock(400000); 

  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    for(;;);
  }

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(10, 20); display.println("Connecting WiFi...");
  display.setCursor(10, 35); display.println(ssid);
  display.display();

  // WiFi Connection
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }

  display.clearDisplay();
  display.setCursor(10, 15); display.println("Connected!");
  display.setCursor(10, 35); display.println(WiFi.localIP());
  display.display();
  delay(2000);

  // Initialize DFPlayer safely on D7, D8
  mySoftwareSerial.begin(9600);
  if (myDFPlayer.begin(mySoftwareSerial)) {
    dfPlayerReady = true;
    myDFPlayer.volume(22);
  }

  if (MDNS.begin("emo")) { Serial.println("mDNS started: http://emo.local"); }

  renderEyes();

  server.on("/", handleRoot);
  server.on("/setMood", handleSetMood);
  server.on("/joyMove", handleJoyMove);
  server.on("/toggleAuto", handleToggleAuto);
  server.on("/getFrame", handleGetFrame);
  server.begin();
}

const char* autoMoods[] = {"normal", "petting", "curious", "wave", "shy", "happy", "love", "confused_q", "thinking", "sleep_zzz"};

void loop() {
  server.handleClient();
  MDNS.update();
  yield();

  if (millis() - lastAnimTick > 30) {
    renderEyes();
    lastAnimTick = millis();
  }

  if (autoMode) {
    if (millis() - lastAutoMove > 3500) {
      int randomIndex = random(0, 10);
      currentMood = autoMoods[randomIndex];
      performSmoothBlink();
      lastAutoMove = millis();
    }
  }
}
